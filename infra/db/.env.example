# Переменные для compose.yaml (подстановка ${...} в самом файле — Postgres).
# Секреты каждого сервиса (GOOGLE_CLIENT_ID/SECRET, JWT_RSA_PRIVATE_KEY_PATH,
# ADMIN_EMAILS и т.д.) по-прежнему живут в их собственных .env файлах
# (google-auth/.env, wallet-api/.env, wallet-gateway/.env, см. их
# .env.example) — compose подключает их через env_file, этот файл их не
# дублирует. У wallet-web (nginx, статика) своего .env нет вообще, см. его
# README.
#
# Лежит здесь, в db/, а не рядом с compose.yaml в корне — все настройки и
# скрипты вокруг самой базы (этот файл, init-db.sh, дальше сюда же лягут
# миграционные скрипты наката) теперь в одном месте, см. infra/db/README.md.
# Из-за этого compose САМ этот файл больше не найдёт (без явного указания он
# ищет ".env" только рядом с compose.yaml) — запускать нужно с явным
# --env-file:
#
#   cp infra/db/.env.example infra/db/.env
#   podman compose --env-file infra/db/.env up -d --build
#   # или (если "podman compose" без провайдера, см. историю чата):
#   python -m podman_compose --env-file infra/db/.env up -d --build

# Один инстанс Postgres (контейнер "db"), но ТРИ РАЗНЫЕ роли — не логин/
# пароль от одного и того же владельца на разные базы (см. README
# wallet-api, "Своя БД", и infra/db/README.md, "Три роли"). Названия переменных
# здесь — MIGRATOR_*/AUTH_*/WALLET_* — наши, для этого .env; сам образ
# postgres требует от compose.yaml другие имена (POSTGRES_USER/PASSWORD/DB)
# — маппинг между ними в compose.yaml, у сервиса "db" (см. комментарий там
# же).

# МИГРАТОР — единственная роль с правом DDL (создание/изменение таблиц),
# владеет схемой обеих баз. Это bootstrap-роль самого образа postgres
# (фактически суперпользователь) — приложения ею НЕ подключаются никогда,
# только init-скрипт при старте "db" и (в будущем) миграционные скрипты
# наката. MIGRATOR_POSTGRES_DB — просто maintenance-база для этой роли,
# сам образ того требует; ни google-auth, ни wallet-api её не используют.
MIGRATOR_POSTGRES_USER=migrator
MIGRATOR_POSTGRES_PASSWORD=change-me-migrator
MIGRATOR_POSTGRES_DB=postgres

# Роль и база google-auth — только DML на свои таблицы (SELECT/INSERT/
# UPDATE/DELETE), ни DDL, ни TRUNCATE — права выдаёт init-db.sh.
AUTH_POSTGRES_USER=google_auth
AUTH_POSTGRES_PASSWORD=change-me
AUTH_POSTGRES_DB=google_auth

# Отдельные роль и база на том же инстансе — под wallet-api (только таблица
# wallets, своя роль без доступа к базе google-auth — см. init-db.sh рядом,
# там же REVOKE CONNECT на "чужую" базу с обеих сторон, и ограничение прав
# до чистого DML). Всё заводится само при первом старте "db" (см. volumes у
# "db" в compose.yaml) — ничего руками создавать не нужно.
WALLET_POSTGRES_USER=wallet_api
WALLET_POSTGRES_PASSWORD=change-me-too
WALLET_POSTGRES_DB=wallet_api

# Четвёртая роль (НЕ одна из "трёх ролей" выше, см. init-db.sh) — под ней
# ходит postgres_exporter (см. compose.yaml, "Grafana/Prometheus"): только
# встроенная pg_monitor (SELECT на pg_stat_*, без доступа к данным таблиц),
# никакого DML/DDL. CONNECT разрешён на обе базы (auth+wallet) — экспортёр
# сам обходит их через --auto-discover-databases.
MONITORING_POSTGRES_USER=postgres_exporter
MONITORING_POSTGRES_PASSWORD=change-me-monitoring

# Пятая роль и своя, отдельная от кошелька, база — история прогонов
# нагрузочного контура (test_run/test_result, см.
# infra/db/migrations/perf/ и wallet-report/loadtest/record_run.sh). Только
# DML на свои будущие таблицы, права выдаёт init-db.sh — тем же принципом,
# что AUTH_/WALLET_POSTGRES_USER выше. Читает эту базу отдельная read-only
# роль perf_reader (под ней ходит Grafana) — заводится не переменными
# отсюда, а самой миграцией perf.
PERF_POSTGRES_USER=perf_history
PERF_POSTGRES_PASSWORD=change-me-perf
PERF_POSTGRES_DB=perf_history

# Шестая роль и своя база — Telegram-бот wallet-telegram (связки чатов и
# offset поллинга, см. wallet-telegram/migrations/). Только DML, права
# выдаёт init-db.sh. К базе кошелька у этой роли доступа нет.
TELEGRAM_POSTGRES_USER=wallet_telegram
TELEGRAM_POSTGRES_PASSWORD=change-me-telegram
TELEGRAM_POSTGRES_DB=wallet_telegram

# Седьмая роль и своя база — wallet-ai (импорты выписок, строки, правила
# продавцов, см. wallet-ai/migrations/). Только DML, права выдаёт init-db.sh.
# Без базы wallet-ai работает, но импорт выписок выключен.
AI_POSTGRES_USER=wallet_ai
AI_POSTGRES_PASSWORD=change-me-ai
AI_POSTGRES_DB=wallet_ai
