@startuml wallet-transaction-logging
title WalletTransaction — конвейер логов: кто пишет, куда, как забирает OpenSearch\n(стек логов — отдельный compose-проект wallet-logging, по умолчанию не запущен)

skinparam componentStyle rectangle
skinparam wrapWidth 220

node "Контейнеры контуров wallet-prod / wallet-test\n(docker, logging.driver: journald у каждого сервиса)" as Containers {
  [google-auth, wallet-api, wallet-report,\nwallet-gateway, wallet-telegram,\nwallet-ai, wallet-mcp,\nwallet-docs (профиль docs)\n\n— C++ (wallet-common util/log), одна\nстрока JSON на событие: level/msg/\nservice/trace_id/route/user_id/ts\n— stdout] as APPS
  [db (Postgres)\nredis\n\n— свой формат, НЕ JSON] as INFRA
  [wallet-web (nginx)\n\n— access/error лог nginx,\nНЕ JSON] as WEB
  [tls-proxy (Caddy)\n\n— тоже journald, но НЕ в whitelist\nfluent-bit: в OpenSearch не попадают\n(только journalctl / docker logs)] as OUTSIDE
}

node "Хост (Linux)" as Host {
  [dockerd\n\n— пишет запись journald на КАЖДУЮ\nстроку stdout/stderr контейнера\n(_COMM=dockerd, поле CONTAINER_NAME)] as DOCKERD
  database "journald\n(/var/log/journal)" as JOURNALD
}

node "fluent-bit\n(fluent/fluent-bit:3.1, проект wallet-logging)" as FB {
  [INPUT: systemd\nPath /var/log/journal\nSystemd_Filter _COMM=dockerd\nDB /fluent-bit/state/journal.db (курсор)\nRead_From_Tail On (только первый запуск)] as FB_IN
  component "FILTER: grep\nCONTAINER_NAME ^wallet-(prod|test)[-_]\n(db|redis|google-auth|wallet-api|\nwallet-report|wallet-web|wallet-gateway|\nwallet-telegram|wallet-ai|wallet-mcp|\nwallet-docs)[-_]\n\n— режет чужие compose-стеки хоста" as FB_GREP
  [FILTER: modify\nRename CONTAINER_NAME->container_name\nRename MESSAGE->message\n+ env prod|test по префиксу контейнера] as FB_RENAME
  [FILTER: parser (app_json)\nKey_Name message, Reserve_Data On,\nPreserve_Key Off\n\n— парсится: прикладные C++ сервисы\n  (ts -> @timestamp, сырой message удаляется)\n— не JSON (db/redis/wallet-web) —\n  запись не трогается] as FB_PARSE
  [FILTER: modify\nRemove_wildcard _\n(+ CODE_FILE/CODE_LINE/CODE_FUNC/\nCONTAINER_ID(_FULL)/\nSYSLOG_IDENTIFIER/PRIORITY)] as FB_CLEAN
  [OUTPUT: opensearch\nHost opensearch:9200, tls Off\nLogstash_Format On,\nLogstash_Prefix wallet-logs\nSuppress_Type_Name On] as FB_OUT
}

database "OpenSearch\n(single-node, security отключен,\nхост :19200 → 9200)" as OS {
  [wallet-logs-YYYY.MM.DD\n(дневные индексы,\nISM wallet-logs-retention:\nудаление через 14 дней)] as IDX
}

node "OpenSearch Dashboards\n(хост :15601)" as OSD {
  [Discover\n(index pattern wallet-logs* + saved search,\nимпортированы dashboards-init из\nsaved_objects.ndjson; фильтр env:prod / env:test)] as DISC
}

APPS --> DOCKERD
INFRA --> DOCKERD
WEB --> DOCKERD
OUTSIDE --> DOCKERD
DOCKERD --> JOURNALD : CONTAINER_NAME, MESSAGE, ...

JOURNALD --> FB_IN : volume ro:\n/var/log/journal,\n/run/log/journal,\n/etc/machine-id

FB_IN --> FB_GREP
FB_GREP --> FB_RENAME
FB_RENAME --> FB_PARSE
FB_PARSE --> FB_CLEAN
FB_CLEAN --> FB_OUT

FB_OUT --> IDX : HTTP :9200 (bulk)

OSD --> IDX : читает при поиске\n/ визуализации

note bottom of FB_IN
  Курсор journald лежит в томе fluent-bit-state: стек логов
  по умолчанию не запущен, а при следующем старте fluent-bit
  дочитывает журнал с места остановки, а не теряет логи за
  время простоя. Read_From_Tail действует только при самом
  первом запуске (пока DB нет) — чтобы не залить весь
  многомесячный журнал хоста.
end note

note right of FB_PARSE
  Разбор по одному правилу (Key_Name message) на все
  контейнеры разом — fluent-bit не различает "app" и
  "infra" заранее. Если формат не JSON, парсер просто не
  срабатывает, запись проходит дальше без изменений.
end note

note bottom of IDX
  Ротация — по дню: wallet-logs-%Y.%m.%d (UTC). Шаблон
  индекса и ISM-политику wallet-logs-retention (delete через
  14 дней) ставит opensearch-init (infra/logging/
  opensearch-init.sh) до старта fluent-bit. prod и test — в
  одном индексе, различаются полем env.
end note

note left of FB_GREP
  Префикс — имя compose-проекта контура (name: wallet-${WALLET_ENV}
  в wallet-infra/compose.yaml). Переименовали проект — правьте и
  регэксп, иначе фильтр молча дропнет все логи. Стеки логов и
  метрик — отдельные проекты (wallet-logging, wallet-monitoring),
  под префикс не подпадают и journald-драйвер не включают.
  Новый сервис контура — дописать в whitelist.
end note

@enduml
