@startuml wallet-transaction-components
title WalletTransaction — компоненты и маршруты контура wallet-<env> (текущее состояние:\nдомен леджера/синка, CQRS-lite отчётов, ИИ, MCP, справка, Telegram-бот, TLS-вход)

skinparam componentStyle rectangle
skinparam wrapWidth 200

actor "Пользователь\n(браузер / Android)" as User
actor "Пользователь\n(Telegram)" as TgUser

cloud "Google" as GoogleCloud {
  [OAuth 2.0\n(Authorization Code + PKCE)] as GoogleOAuth
  [JWKS\n(/oauth2/v3/certs)] as GoogleJWKS
}

cloud "Telegram Bot API\napi.telegram.org" as TG

node "Публичная точка входа" {
  [tls-proxy (Caddy)\n:443 → хост 8443 (prod) / 8444 (test)\n\n— профиль tls, только при WALLET_TLS=true\n  (сейчас на test; на prod выключен)\n— X-Forwarded-Proto/Host гейтвею\n— см. tls-ingress-components.puml] as TLS
  [wallet-gateway\n:8090 (хост 8090 prod / 8091 test;\nпри TLS — только 127.0.0.1)\n\n— JWT-гейт по aud маршрута\n— GET /api/versions — сводка версий\n  всех сервисов (и бота)] as GW
}

node "Внутренние сервисы (сеть wallet-<env>)" {
  [google-auth\n:8080 публичный (/auth/*, /admin/*, JWKS)\n:8443 служебный /internal/* по mTLS\n(:8081 без TLS — на test закрыт)\n\n— вход через Google ИЛИ по паролю\n  (AUTH_METHODS, GET /auth/methods)\n— выпуск/ротация сессии (access + refresh),\n  «Мои устройства» (/auth/devices)\n— персональные MCP-токены wmcp_…\n— обмен токена RFC 8693, токены бота\n— /admin/users (+ logout, пароль) — JSON] as AUTH
  [wallet-api\n:8082\n\n— синк: POST /sync/push, GET /sync/pull,\n  /sync/blobs (HEAD/GET/POST)\n— доступ/приглашения: /api/ledger/*,\n  /api/invites/accept\n— справочники: /api/currencies,\n  /api/currency-pairs, /api/currency-routes,\n  /api/admin/icons\n— флаг LEDGER_ICON_UPLOAD (test on, prod off)\n— читает JWT (JWKS), не выпускает] as API
  [wallet-report\n:8084\n\n— CQRS-lite: GET /api/reports/*\n  (баланс, доход/расход, структура,\n  операции, активы, долги, контрагенты,\n  data-range, icons, admin/users/stats)\n— читает ТУ ЖЕ базу, что wallet-api,\n  ролью wallet_reader (только SELECT)] as REPORTS
  [wallet-ai\n:8087\n\n— задания POST /api/ai/jobs: parse_expense,\n  chat, импорт выписок (/api/ai/imports)\n— ход чата — SSE /api/ai/jobs/{id}/events\n— провайдеры: lmstudio, claude (по согласию,\n  на test/prod не настроен)\n— НИЧЕГО не пишет в кошелёк\n— своя база ai (импорт выписок)] as AI
  [wallet-mcp\n:8088\n\n— MCP (Streamable HTTP): POST /api/mcp/,\n  8 инструментов только для чтения поверх\n  wallet-report + ask_docs (при WALLET_DOCS_URL)\n— доступ: wmcp_… или JWT aud wallet-mcp\n— своей БД и Redis нет] as MCP
  [wallet-docs\n:8089, профиль docs (сейчас и в test, и в prod)\n\n— POST /api/docs/ask, GET /api/docs/status —\n  ответы по OpenSpec-спекам (RAG)\n— область разделов — по role/platform JWT\n— индекс заливает Jenkins:\n  PUT /docs/index/{repo} (docs-index.sh)] as DOCS
  [wallet-telegram\n:8086 (только /healthz /metrics /version)\n\n— long polling Bot API, команды чтения,\n  трата строгим форматом и свободным текстом,\n  вопросы в чат wallet-ai\n— своя база telegram (настройки, offset)] as BOT
}

node "Хост (вне docker, GPU)" {
  [LM Studio\n:1234, OpenAI API\n(wallet-parse; эмбеддинги wallet-docs)] as LLM
}

cloud "Anthropic API\n(провайдер claude,\nтолько с ключом и согласием)" as ANTH

node "Статика (nginx, без JWT)" {
  [wallet-web\n(nginx)\n:80\n\n— SPA: «Отчёты», чат, справка, импорт,\n  админка иконок/пользователей\n— НЕ проверяет JWT — это делает app.js\n  через fetch() к /auth/me и /api/*\n— try_files .../index.html — фолбэк\n  для /join/<token> и прочих маршрутов SPA] as WEB
}

database "db — ОДИН Postgres контура\n(pgvector/pgvector:pg16),\nбаза и роль на сервис" as PG {
  [база auth\n(users, user_passwords (PBKDF2),\ntelegram_links; справочник ролей\nuser / support / admin)] as T_USERS
  [база wallet\nledger, ledger_member, ledger_invite,\napp_user, device (+ подтверждения\npull), sync_push_batch, change_stream,\naccount/operation/currency/icon/blob,\ncounterparty, account_debt, …\n(см. sync-sequence.puml)] as T_LEDGER_DOMAIN
  [база telegram\n(tg_link, tg_update_offset)] as T_TG
  [база ai\n(импорт выписок, профили)] as T_AI
  [база docs\n(чанки спек + векторы pgvector)] as T_DOCS
}

database "Redis\n(только google-auth,\nAOF + volume;\nACL — см. note)" as REDIS {
  [access_token:<hash>\n(TTL = ACCESS_TOKEN_TTL_SECS,\nзначение — user_id)] as T_ACCESS
  [refresh_token:<hash>\n(TTL = REFRESH_TOKEN_TTL_SECS,\nодноразовый — GETDEL при\nкаждом /auth/refresh)] as T_REFRESH
  [user_access_tokens:<id>\nuser_refresh_tokens:<id>\nuser_mcp_tokens:<id>\n(множества-индексы — SMEMBERS\nдля отзыва всех токенов)] as T_INDEX
  [mcp_token:<hash>, tg_link_code:<hash>,\nauthfail:email:/authfail:ip:\n(счётчики неудачных входов)] as T_MISC
}

User --> TLS : HTTPS (если TLS-вход включён)
TLS --> GW : HTTP + X-Forwarded-*
User --> GW : HTTP напрямую (без TLS-входа)
TgUser --> TG : личный чат с ботом

GW --> AUTH    : "/auth/*, /admin/* — без JWT-гейта\n(своя auth/role-логика внутри)"
GW --> REPORTS : "/api/reports/* — гейт aud wallet-report\n(ДО общего /api/*)"
GW --> AI      : "/api/ai/* — гейт aud wallet-ai\n(text/event-stream проксируется потоком)"
GW --> DOCS    : "/api/docs/* — гейт aud wallet-docs\n(без профиля docs — 404)"
GW --> MCP     : "/api/mcp/* — БЕЗ гейта:\nтокен проверяет сам wallet-mcp"
GW --> API     : "/api/*, /sync/* — гейт aud wallet-api"
GW --> WEB     : "всё остальное — открыт\n(фолбэк, включая /join/<token>)"

GW ..> AUTH : "GET /.well-known/jwks.json\n(при старте + при незнакомом kid,\nкэшируется в памяти)"
API ..> AUTH : "JWKS"
REPORTS ..> AUTH : "JWKS"
AI ..> AUTH : "JWKS; POST /internal/token/exchange\n(служебный порт, mTLS)"
MCP ..> AUTH : "JWKS; POST /internal/mcp/token (wmcp_…);\nPOST /internal/token/exchange (JWT)\n— служебный порт, mTLS"
DOCS ..> AUTH : "JWKS"
BOT ..> AUTH : "POST /internal/telegram/exchange,\n/internal/telegram/token, DELETE links\n— служебный порт, mTLS"

AI --> MCP : "чат: tools/list, tools/call\nJWT обмена (aud wallet-mcp, act wallet-ai),\nсм. token-exchange-sequence.puml"
AI --> REPORTS : "справочник счетов\n(токеном пользователя)"
AI ..> LLM : "chat/completions (+ стрим),\nGET /v1/models (проба)"
AI ..> ANTH : "Messages API\n(только провайдер claude)"
MCP --> REPORTS : "GET /api/reports/* — JWT обмена\n(aud wallet-report, reports:read)"
MCP --> DOCS : "ask_docs: POST /api/docs/ask —\nJWT обмена (aud wallet-docs, docs:ask)"
DOCS ..> LLM : "LLM + эмбеддинги"
BOT --> TG : "getUpdates (long polling),\nsendMessage — только исходящий HTTPS"
BOT --> REPORTS : "команды чтения\n(токен бота)"
BOT --> API : "POST /sync/push —\nтрата по «✓ Записать»"
BOT --> AI : "задания parse_expense / chat,\nSSE событий, /api/ai/settings"

AUTH --> T_USERS
AUTH --> T_REFRESH : SET..EX при выдаче,\nGETDEL при /auth/refresh\n(атомарная ротация),\nDEL при /auth/logout
AUTH --> T_ACCESS : SET..EX при выдаче,\nEXISTS в authenticate(),\nDEL при /auth/logout
AUTH --> T_INDEX : SADD+EXPIRE при каждой выдаче,\nSMEMBERS+DEL при отзыве всех\n(admin logout, смена пароля, «отключить все»)
AUTH --> T_MISC
AUTH --> GoogleOAuth : обмен code на id_token
AUTH --> GoogleJWKS : проверка подписи id_token

API --> T_LEDGER_DOMAIN : роль wallet (только DML —\nсхему накатывает мигратор,\ninfra/env/migrate.sh)
REPORTS --> T_LEDGER_DOMAIN : ТОЛЬКО SELECT, роль wallet_reader
BOT --> T_TG
AI --> T_AI
DOCS --> T_DOCS

note bottom of GW
  Проверяет ТОЛЬКО подпись, exp и aud access-токена
  на своих маршрутах. Роль/владение ресурсом и scope —
  забота бекенда (см. README wallet-gateway, "Почему не
  дублируем авторизацию"). Вход гейтвея — обычный HTTP
  даже при mTLS внутри контура: это граница контура
  (add-internal-mtls, D9), к апстримам — по mTLS.
end note

note bottom of AUTH
  Подписывает access-токены приватным RSA-ключом
  (RS256) и публикует публичную часть на
  /.well-known/jwks.json. Общего секрета в конфиге
  остальных сервисов нет. /internal/* гейтвей НЕ
  проксирует: служебный порт привязан к алиасу
  google-auth-internal в отдельной сети auth-internal
  (google-auth, wallet-telegram, wallet-mcp, wallet-ai),
  из общей сети контура он недоступен.
  Подробно — internal-mtls-components.puml.
end note

note right of AUTH
  redirect_uri строится из X-Forwarded-Host/Host
  (голый 192.168.x.y → <ip>.nip.io) и принимается,
  только если есть в ALLOWED_REDIRECT_URIS (иначе
  REDIRECT_URL) — Google возвращает браузер на ГЕЙТВЕЙ
  (или TLS-прокси), тот проксирует /auth/google/callback
  сюда тем же открытым префиксом /auth/*. После
  логина — 302 на "/": SPA (WEB) подхватит сессию
  через /auth/me. Вход по паролю — только при
  X-Forwarded-Proto: https (или ALLOW_INSECURE_AUTH).
end note

note left of AUTH
  pending (state -> PKCE verifier, redirect_uri) и
  pending_signups (confirm_token -> проверенные
  Google-claims нового пользователя) — В ПАМЯТИ процесса.
  При перезапуске незавершённый вход/подтверждение
  регистрации обрывается — пользователь начнёт заново.
end note

note bottom of REDIS
  access_token: НЕ источник истины о валидности — это
  делает подпись+exp самого JWT. Смысл — дать
  POST /auth/logout отозвать токен РАНЬШЕ его exp, но
  только для проверок ВНУТРИ google-auth (GET /auth/me,
  /admin/*, /auth/devices). Остальные сервисы в Redis
  не ходят и про такое отозвание не узнают до exp.

  refresh_token: НАОБОРОТ, источник истины — единственная
  копия секрета (хранится хэш), GETDEL — единственный способ
  его предъявить и погасить одновременно.

  Поэтому этот Redis — с AOF и volume, не эфемерный кэш:
  потеря refresh_token = принудительный релогин всех.

  Доступ (add-redis-auth, WALLET_REDIS_AUTH): на test — on
  (ACL-пользователи google-auth / exporter / health / admin,
  default выключен), на prod — выключен (по prod.env).
  TLS до Redis нет ни в одном контуре (свой RESP-клиент
  google-auth без TLS) — защита только паролем и ACL.
end note

note bottom of REPORTS
  CQRS-lite — та же база wallet, что у wallet-api (те же
  миграции), но ОТДЕЛЬНЫЙ процесс с read-only соединением
  ролью wallet_reader. Полный CQRS с раздельными
  хранилищами и брокером сознательно отклонён.
end note

note right of T_LEDGER_DOMAIN
  ledger_invite: token_hash — sha256(сырой токен), hex. Сырой
  токен НИКОГДА не попадает в базу — только в ответ
  POST /api/ledger/invites и в саму ссылку (invite-sequence.puml).
  role приглашения — только member/reader; передача владения —
  POST /api/ledger/transfer-owner.
  Удалённые строки (tombstone) физически вычищаются, когда их
  получили все активные устройства (purge-synced-tombstones).
end note

note right of MCP
  Обмен токена (RFC 8693): сервис меняет токен
  пользователя на JWT для ОДНОГО следующего адресата;
  кто кого может просить — таблица политики
  google-auth, actor — по X-Service-Secret и (на test
  в режиме enforce) по сертификату mTLS. Цепочка — в
  claim act. Подробно — token-exchange-sequence.puml.
end note

note bottom of PG
  Базы и роли заводит infra/db/init-db.sh при первом старте
  тома; таблицы — только миграции (migrate.sh). Роль docs и
  расширение vector — только если заданы DOCS_POSTGRES_*.
  При WALLET_INTERNAL_MTLS=true — ssl=on, hostnossl reject,
  клиенты sslmode=verify-full (клиентский сертификат роли
  пока не требуется).
end note

note as N1
  Сплошная стрелка (-->) — обычный вызов.
  Пунктирная (..>) — служебный/побочный вызов
  (JWKS, /internal/*, LLM) сбоку от гейтвея.
  Все вызовы между сервисами при WALLET_INTERNAL_MTLS=true
  идут по mTLS (см. internal-mtls-components.puml).
end note

@enduml
