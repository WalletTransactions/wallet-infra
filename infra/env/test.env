# Настройки контура test — без секретов (секреты: ~/.config/wallet-secrets/test/).
# Подставляются в compose.yaml через infra/env/up.sh. Отличия от prod.env —
# это и есть все отличия контуров, кроме секретов.
WALLET_ENV=test
WALLET_GATEWAY_PORT=8091
# Postgres только на 127.0.0.1 этой машины (DBeaver/psql).
WALLET_DB_PORT=15432
# Под нехваткой памяти хоста ядро убивает test первым (design D10).
WALLET_OOM_ADJ=500
# ИИ включён явно (решение 2026-10-24): тот же LM Studio, что у prod. GPU
# один — тяжёлые задания test (импорт выписок) занимают его и у prod.
# Выключить — оставить LLM_URL пустым (design D8).
LLM_URL=http://host.docker.internal:1234/v1
LLM_MODEL=wallet-parse
# Поток событий chat (wallet-ai chat-sse-events): ответ по мере генерации.
# Нужны wallet-gateway с proxy-sse-stream (rc.2+) и wallet-ai rc.2+; без них
# клиенты работают опросом статуса. Отключить — false или убрать строку.
AI_STREAM_ENABLED=true
# Справка wallet-docs — необязательный модуль (change wallet-docs-assistant).
# Включена на test с 2026-11-13 двумя строками ниже, обе вместе (до этого они
# правились руками в выкатанной копии, из-за чего deploy.sh wallet-infra
# падал на git checkout); на prod — закомментированы (см. infra/env/README.md):
COMPOSE_PROFILES=docs
WALLET_DOCS_URL=http://wallet-docs:8089
# TLS на входе контура — необязателен (change add-tls-ingress, infra/env/README.md).
# Порт прокси задан всегда; включается одной строкой WALLET_TLS=true, остальное
# (COOKIE_SECURE, TRUST_FORWARDED_HEADERS, порт гейтвея только на 127.0.0.1)
# выводит infra/env/tls.sh. WALLET_TLS_MODE: internal | files | tailscale.
WALLET_TLS_PORT=8444
# Включён на test 2026-11-20 (prod — после проверки). Вход: https://<адрес>:8444
# по адресам ниже; http://<хост>:8091 с других машин закрыт. Для входа через
# Google https-варианты redirect_uri с портом 8444 — в ALLOWED_REDIRECT_URIS
# (google-auth.env) и Google Console (infra/env/README.md).
WALLET_TLS=true
WALLET_TLS_MODE=tailscale
WALLET_TLS_HOST=192.168.1.105,192.168.1.105.nip.io,ivan-pc.tail5afb65.ts.net
# Способы входа (перекрывают google-auth.env, если заданы):
#WALLET_AUTH_METHODS=both
#WALLET_REGISTRATION=closed
#WALLET_ALLOW_INSECURE_AUTH=false
# mTLS служебного порта google-auth (change add-internal-mtls, шаг 4, пилот на test):
# бот, wallet-mcp и wallet-ai ходят на /internal/* по взаимному TLS (:8443) (шаги 4–5).
# observe: расхождения идентичности только в журнал и метрику internal_identity_total,
# запросы не отклоняются (infra/env/README.md, «mTLS на служебном порту»).
WALLET_AUTH_MTLS_CLIENTS=wallet-telegram,wallet-mcp,wallet-ai
WALLET_AUTH_IDENTITY=observe
# Задача 6.1 add-internal-mtls: /internal/* на публичном порту google-auth закрыты (404),
# остались только служебные порты. Нужен google-auth не ниже 0.4.3.
WALLET_AUTH_INTERNAL_PUBLIC=false
# Задача 6.2: служебный порт без TLS (:8081) не слушается, остаётся :8443 (mTLS). Все три
# клиента уже на mTLS (WALLET_AUTH_MTLS_CLIENTS выше).
WALLET_AUTH_INTERNAL_PLAIN=false
