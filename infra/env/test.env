# Настройки контура test — без секретов (секреты: ~/.config/wallet-secrets/test/).
# Подставляются в compose.yaml через infra/env/up.sh. Отличия от prod.env —
# это и есть все отличия контуров, кроме секретов.
WALLET_ENV=test
WALLET_GATEWAY_PORT=8091
# Postgres только на 127.0.0.1 этой машины (DBeaver/psql).
WALLET_DB_PORT=15432
# Под нехваткой памяти хоста ядро убивает test первым (design D10).
WALLET_OOM_ADJ=500
# ИИ включён явно (решение 2026-10-24): тот же LM Studio, что у prod. GPU
# один — тяжёлые задания test (импорт выписок) занимают его и у prod.
# Выключить — оставить LLM_URL пустым (design D8).
LLM_URL=http://host.docker.internal:1234/v1
LLM_MODEL=wallet-parse
# Справка wallet-docs — необязательный модуль (change wallet-docs-assistant).
# Включается двумя строками ниже, обе вместе, после появления образа
# wallet-docs в ghcr и DOCS_POSTGRES_* в db.env (см. infra/env/README.md):
#COMPOSE_PROFILES=docs
#WALLET_DOCS_URL=http://wallet-docs:8089
