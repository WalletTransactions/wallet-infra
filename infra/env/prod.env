# Настройки контура prod — без секретов (секреты: ~/.config/wallet-secrets/prod/).
# Подставляются в compose.yaml через infra/env/up.sh. Отличия от test.env —
# это и есть все отличия контуров, кроме секретов.
WALLET_ENV=prod
WALLET_GATEWAY_PORT=8090
# Postgres только на 127.0.0.1 этой машины (DBeaver/psql).
WALLET_DB_PORT=15555
# Под нехваткой памяти хоста ядро убивает prod последним (design D10).
WALLET_OOM_ADJ=-900
# LM Studio на хосте (design D8).
LLM_URL=http://host.docker.internal:1234/v1
LLM_MODEL=wallet-parse
# Справка wallet-docs — необязательный модуль (change wallet-docs-assistant).
# Включается после test, двумя строками вместе (см. infra/env/README.md):
#COMPOSE_PROFILES=docs
#WALLET_DOCS_URL=http://wallet-docs:8089
