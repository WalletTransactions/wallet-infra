# Настройки контура prod — без секретов (секреты: ~/.config/wallet-secrets/prod/).
# Подставляются в compose.yaml через infra/env/up.sh. Отличия от test.env —
# это и есть все отличия контуров, кроме секретов.
# Порядок разделов в test.env и prod.env одинаков: сравнивайте файлы построчно.
# Подробности по каждому разделу — infra/env/README.md.
#
# Разделы: 1. Контур · 2. ИИ · 3. Справка · 4. TLS на входе · 5. Способы входа ·
#          6. mTLS служебного порта · 7. mTLS внутри контура · 8. Redis

# ── 1. Контур ───────────────────────────────────────────────────────────────
# Имя контура: префикс контейнеров (wallet-<env>-…), каталогов секретов и состояния.
WALLET_ENV=prod
# Порт гейтвея на хосте — единственный вход в контур по HTTP.
WALLET_GATEWAY_PORT=8090
# Postgres только на 127.0.0.1 этой машины (DBeaver/psql).
WALLET_DB_PORT=15555
# Приоритет при нехватке памяти хоста (oom_score_adj): чем больше число, тем раньше
# ядро убивает контейнеры. prod — последним, test — первым (design D10).
WALLET_OOM_ADJ=-900

# ── 2. ИИ ───────────────────────────────────────────────────────────────────
# Адрес LM Studio на хосте и имя модели (design D8). Тот же LM Studio, что у test.
# Выключить ИИ — оставить LLM_URL пустым.
LLM_URL=http://host.docker.internal:1234/v1
LLM_MODEL=wallet-parse
# Поток событий chat (wallet-ai chat-sse-events): ответ по мере генерации.
# Включается после test и выката wallet-gateway/wallet-ai/wallet-telegram с поддержкой
# потока. Отключить — false или убрать строку.
AI_STREAM_ENABLED=true

# Свои иконки пользователей (wallet-api 0.4.11+, change optional-icon-upload): on —
# телефон с включённой настройкой отправляет свои иконки в набор «Свои» леджера;
# off — сервер их не принимает, телефоны сами выключают отправку. Админу не мешает.
# Включать после проверки на test и релиза Android с настройкой отправки.
LEDGER_ICON_UPLOAD=off

# ── 3. Справка wallet-docs ──────────────────────────────────────────────────
# Необязательный модуль (change wallet-docs-assistant). Две строки ниже включаются
# только вместе: профиль запускает контейнер, URL говорит гейтвею, куда ходить.
# Включается после test. Править эти строки только в git, не в выкатанной копии:
# иначе deploy.sh wallet-infra падает на git checkout.
COMPOSE_PROFILES=docs
WALLET_DOCS_URL=http://wallet-docs:8089

# ── 4. TLS на входе контура ─────────────────────────────────────────────────
# Необязателен (change add-tls-ingress). Включается одной строкой WALLET_TLS=true,
# остальное (COOKIE_SECURE, TRUST_FORWARDED_HEADERS, порт гейтвея только на
# 127.0.0.1) выводит infra/env/tls.sh.
# Порт TLS-прокси на хосте; задан всегда, даже при выключенном TLS.
WALLET_TLS_PORT=8443
# На prod выключен: включать после проверки на test (там с 2026-11-20).
#WALLET_TLS=true
# Источник сертификата: internal (CA Caddy) | tailscale (Let's Encrypt для *.ts.net) | files.
#WALLET_TLS_MODE=tailscale
# Все адреса, по которым открывают контур (через запятую); сертификат проверяется по
# адресу из URL, остальные адреса не работают.
#WALLET_TLS_HOST=192.168.1.105,192.168.1.105.nip.io,ivan-pc.tail5afb65.ts.net

# ── 5. Способы входа ────────────────────────────────────────────────────────
# Необязательные. Если строка задана, перекрывает такую же настройку в google-auth.env;
# если нет — действует значение из секрета или умолчание google-auth.
#WALLET_AUTH_METHODS=both
#WALLET_REGISTRATION=closed
#WALLET_ALLOW_INSECURE_AUTH=false

# ── 6. mTLS служебного порта google-auth ────────────────────────────────────
# Change add-internal-mtls. Критичный путь выдачи токенов (/internal/*) защищён
# отдельно и раньше остального контура. Перед включением на хосте один раз:
# bash infra/env/mtls-init.sh prod (создаёт CA контура; на prod выполнено 2026-11-22).
# Клиенты служебного порта, которые ходят по mTLS (:8443), через запятую. Остальные
# остаются на :8081 без TLS — переносить можно по одному.
WALLET_AUTH_MTLS_CLIENTS=wallet-telegram,wallet-mcp,wallet-ai
# Проверка идентичности клиента на google-auth: off | observe (журнал и метрика
# internal_identity_total, ничего не отклоняется) | enforce-tls (403 без сертификата
# и при CN ≠ actor) | enforce (то же и 403 сервису не из списка). Можно по группам:
# observe,telegram=enforce. Путь: сутки observe без расхождений → enforce-tls →
# enforce (на test пройден). Проверка расхождений — README, «mTLS на служебном порту».
# Откат — observe.
WALLET_AUTH_IDENTITY=enforce
# Закрытие остаточных путей — только когда все три клиента на mTLS и режим enforce
# проработал без расхождений. Нужен google-auth не ниже 0.4.3. Откат — true или
# убрать строку.
# /internal/* на публичном порту google-auth: false → 404, остаются служебные порты.
WALLET_AUTH_INTERNAL_PUBLIC=false
# Служебный порт без TLS (:8081): false → не слушается, остаётся :8443 (mTLS).
WALLET_AUTH_INTERNAL_PLAIN=false

# ── 7. mTLS внутри контура ──────────────────────────────────────────────────
# Весь контур на взаимном TLS: серверы требуют клиентский сертификат, вызовы между
# сервисами идут по https. Сертификаты (30 дней) выпускает mtls.sh при каждом up.sh и
# выкате. Образы всех сервисов должны иметь метку org.wallet.mtls=1, иначе up.sh и
# deploy.sh откажут до любых действий. После включения перезапустите
# infra/monitoring/up.sh (Prometheus переключается на https). Откат — убрать строку
# и выкатить заново.
WALLET_INTERNAL_MTLS=true

# ── 8. Redis ────────────────────────────────────────────────────────────────
# ACL и пароли (change add-redis-auth). Режимы: off | compat (ACL-пользователи,
# default ещё без пароля — совместимость и откат) | on (default выключен). Пароли:
# bash infra/env/redis-init.sh prod один раз на хосте; google-auth не ниже 0.4.5
# должен быть выкачен раньше. На prod: compat и on с 2026-11-23 (шаги 2–5 RD6).
# Откат — compat (default снова без пароля).
WALLET_REDIS_AUTH=on
