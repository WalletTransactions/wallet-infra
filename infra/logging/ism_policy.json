{
  "policy": {
    "description": "wallet-logs-*: удалять дневной индекс через 14 дней после создания",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [{ "state_name": "delete", "conditions": { "min_index_age": "14d" } }]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [{ "index_patterns": ["wallet-logs-*"], "priority": 100 }]
  }
}
